build/
lib/
bin/
.DS_Store
__pycache__/
*.py[cod]

# Models are large (GBs) — fetched on demand via `make fetch-model`. No
# trailing slash: a worktree's gguf_artifacts symlink must be ignored too.
gguf_artifacts
*.gguf
*.safetensors
*.part

# Leftover CLI symlinks from before the engine/agent split (the agent layer
# owns the binary now). This repo no longer produces them, but older working
# copies still have them lying around -- and one got committed that way.
/geist
/geist-bitnet

# Benchmark scratch outputs. Runs default to ~/bench-geistlib (outside the repo).
*.npy
summary.json
module_tree.txt

# JetBrains IDE
.idea/

# internal agent config / scratch (not part of the public docs)
.agent/

# generated by tools/gen_test_wav.py (CI audio smoke)
audio_test_data/smoke.wav

# in-place built example binaries
/examples/dictate
/examples/simple_generate
/examples/push_to_talk
/examples/embed_smoke
/examples/agent_contract_smoke
/examples/runtime_contract_smoke
/examples/geist_calibrate

# Outputs of the examples/ffi build instructions (README.md, generate.rs).
/libgeist.dylib
/libgeist.so
/generate_rs
/examples/ffi/generate_rs

# Local symlink to the audio bench assets; never a tracked path (dangling in CI).
/audio_bench
