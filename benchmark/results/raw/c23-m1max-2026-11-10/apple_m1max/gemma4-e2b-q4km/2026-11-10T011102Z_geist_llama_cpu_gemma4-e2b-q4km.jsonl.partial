{"created_utc": "2026-11-10T01:11:02.661670+00:00", "engines": [{"binary": "/private/tmp/claude-502/-Users-germar-workspace-geistlib/98487a9a-a320-41ba-b85c-ad448e7b04cd/scratchpad/cpu/bin/mac-omp/release/tests/bench_perf_sweep", "binary_sha256": "907940775b8c3b537a7f3b2da8fc22a9cad3095f6834eeea1e5c278a77beb93b", "commit": "unavailable", "kind": "geist", "label": "geist", "linked_libraries": ["/private/tmp/claude-502/-Users-germar-workspace-geistlib/98487a9a-a320-41ba-b85c-ad448e7b04cd/scratchpad/cpu/bin/mac-omp/release/tests/bench_perf_sweep:", "\t/System/Library/Frameworks/Accelerate.framework/Versions/A/Accelerate (compatibility version 1.0.0, current version 4.0.0)", "\t/opt/homebrew/opt/libomp/lib/libomp.dylib (compatibility version 5.0.0, current version 5.0.0)", "\t/usr/lib/libSystem.B.dylib (compatibility version 1.0.0, current version 1359.0.0)"]}, {"binary": "/Users/germar/llama.cpp-cross-engine/build-cpu/bin/llama-bench", "binary_sha256": "79eead356a939e1722ff11cac69d0eb0bce917ab71d5230f88da1633899daeba", "commit": "d81235049384534c167caea52b85a694f6103d14", "kind": "llama", "label": "llama.cpp", "linked_libraries": ["/Users/germar/llama.cpp-cross-engine/build-cpu/bin/llama-bench:", "\t@rpath/libllama-bench-impl.dylib (compatibility version 0.0.0, current version 0.0.0)", "\t@rpath/libllama-common.0.dylib (compatibility version 0.0.0, current version 0.0.0)", "\t@rpath/libllama.0.dylib (compatibility version 0.0.0, current version 0.0.0)", "\t@rpath/libggml.0.dylib (compatibility version 0.0.0, current version 0.26.0)", "\t@rpath/libggml-cpu.0.dylib (compatibility version 0.0.0, current version 0.26.0)", "\t@rpath/libggml-blas.0.dylib (compatibility version 0.0.0, current version 0.26.0)", "\t@rpath/libggml-base.0.dylib (compatibility version 0.0.0, current version 0.26.0)", "\t/usr/lib/libc++.1.dylib (compatibility version 1.0.0, current version 2200.27.0)", "\t/usr/lib/libSystem.B.dylib (compatibility version 1.0.0, current version 1359.0.0)"]}], "host_gate": {"apple_power_gate": true, "apple_temp_gate": {"fallback_seconds": 45, "max_cpu_c": 65, "note": "Every run starts on a cool chip (#17, benchmark/METHODOLOGY.md#cool-start-on-apple-silicon): the same rule as the Metal profile, here on the CPU temperature, which an 8-thread prefill drives as hard as Metal drives the GPU. Measured on the M1 Max (2026-10-21, macmon): idle under the lock the chip settles at GPU 49-55 C, CPU 50-55 C; Metal prefill takes the GPU from 49 to 76 C in 7 s, the clock leaves 1293 MHz at 78-83 C and the GPU reaches 96 C after 90 s; from there it is back below 65 C in about 40 s and below 60 C in about 75 s (CPU alike). Without macmon the gate pauses 45 s instead and records cool_gate=time."}, "cooldown_seconds": 60, "max_load_per_core": 0.2, "max_repeat_spread_pct": 5, "max_retries": 3, "min_cpu_idle_pct": 80, "note": "Replaces the load-average test on this host (bench_cross_engine.py host_is_quiet): macOS on an interactive desktop shared with agents never shows a load average near 0.2/core (2026-10-12: 4-8 at 73 % idle), so the frozen gate waited out Gitea's 3 h job limit without one measurement. The host is quiet when >= 80 % of all cores stayed idle over the settle window; the other agents' benchmarks are excluded by ~/bin/with-mac-lock. A run whose repeats spread by more than 5 % (prefill or decode, any length) is discarded and measured again, up to 3 times: the gate before a run cannot see work that starts during it. A cell waits at most 20 min for a quiet host and then fails as busy: Gitea hands the macOS runner its jobs in ID order, so a nightly cell waiting 2 h per cycle on a desktop in use held every macOS CI check behind it for a day (2026-10-13).", "settle_seconds": 30, "temp_gate": {"max_millic": 62000, "note": "passively cooled hosts (pi5) throttle at ~80C; measurements start below 62C so a full phase stays under throttle. Hosts without the sensor path skip this gate.", "sensor": "/sys/class/thermal/thermal_zone0/temp"}, "timeout_seconds": 1200}, "host_profile": "apple_m1max", "kind": "metadata", "model": {"file": "gemma4-e2b-Q4_K_M.gguf", "key": "gemma4-e2b-q4km", "path": "/Users/germar/geist-models/gemma4-e2b-Q4_K_M.gguf", "sha256": "740185b21d22ceb83a11c3aa62ad5842ef32c70f6096d756bbee85a1e4ec34b8"}, "protocol": {"host_gate": {"cooldown_seconds": 60, "max_load_per_core": 0.2, "settle_seconds": 30, "temp_gate": {"max_millic": 62000, "note": "passively cooled hosts (pi5) throttle at ~80C; measurements start below 62C so a full phase stays under throttle. Hosts without the sensor path skip this gate.", "sensor": "/sys/class/thermal/thermal_zone0/temp"}, "timeout_seconds": 14400}, "host_profiles": {"amd_9950x": {"decode_threads": 15, "expect_backend": "cpu_x86", "note": "16 physical cores, SMT siblings excluded. Measured, not assumed: benchmark/results/THREAD-SWEEP-AMD9950X.md sweeps 4-32 threads and finds the joint optimum at 16 for both engines, with llama.cpp prefill collapsing ~6x under SMT. Decode uses 15 by the core-minus-one rule; that specific value sits on the 12-16 plateau but was not measured on its own.", "prefill_threads": 16}, "apple_m1max": {"decode_threads": 7, "expect_backend": "cpu_neon", "host_gate": {"apple_power_gate": true, "apple_temp_gate": {"fallback_seconds": 45, "max_cpu_c": 65, "note": "Every run starts on a cool chip (#17, benchmark/METHODOLOGY.md#cool-start-on-apple-silicon): the same rule as the Metal profile, here on the CPU temperature, which an 8-thread prefill drives as hard as Metal drives the GPU. Measured on the M1 Max (2026-10-21, macmon): idle under the lock the chip settles at GPU 49-55 C, CPU 50-55 C; Metal prefill takes the GPU from 49 to 76 C in 7 s, the clock leaves 1293 MHz at 78-83 C and the GPU reaches 96 C after 90 s; from there it is back below 65 C in about 40 s and below 60 C in about 75 s (CPU alike). Without macmon the gate pauses 45 s instead and records cool_gate=time."}, "max_repeat_spread_pct": 5, "max_retries": 3, "min_cpu_idle_pct": 80, "note": "Replaces the load-average test on this host (bench_cross_engine.py host_is_quiet): macOS on an interactive desktop shared with agents never shows a load average near 0.2/core (2026-10-12: 4-8 at 73 % idle), so the frozen gate waited out Gitea's 3 h job limit without one measurement. The host is quiet when >= 80 % of all cores stayed idle over the settle window; the other agents' benchmarks are excluded by ~/bin/with-mac-lock. A run whose repeats spread by more than 5 % (prefill or decode, any length) is discarded and measured again, up to 3 times: the gate before a run cannot see work that starts during it. A cell waits at most 20 min for a quiet host and then fails as busy: Gitea hands the macOS runner its jobs in ID order, so a nightly cell waiting 2 h per cycle on a desktop in use held every macOS CI check behind it for a day (2026-10-13).", "timeout_seconds": 1200}, "note": "8 performance cores; decode leaves one core to the OS", "prefill_threads": 8}, "apple_m6_mini": {"decode_threads": 5, "expect_backend": "cpu_neon", "host_gate": {"apple_power_gate": true, "apple_temp_gate": {"fallback_seconds": 45, "max_cpu_c": 45, "note": "Measured on the M6 (2026-10-29, macmon, geist 1024-token prefill, 6 threads, six calls back to back): the performance-core clock fell from 4692 to 3645 MHz (-22 %) and the prefill from 322 to 247 tok/s (-23 %) as the CPU went from 50 to 67 C, while the fan stayed at its minimum 1000 rpm; at 47 C the clock was still at its top. So every engine call starts below 45 C, and cool_each_repeat makes that one call per sequence length and repeat (bench_cross_engine.run_cooled): back-to-back repeats inside one call measured the throttling (repeat spread 6-15 %, runs 2204 and 2246). Idle under the lock the chip sits at 25-31 C."}, "cool_each_repeat": true, "max_repeat_spread_pct": 5, "max_retries": 3, "min_cpu_idle_pct": 80, "note": "As the M1 Max profile: >= 80 % of all cores idle over the settle window, repeats within 5 %, at most 20 min of waiting. A dedicated CI host (runner macmini-m6): other measurements are excluded by ~/bin/with-macmini-lock, and the runner hooks hold that lock for every job.", "timeout_seconds": 1200}, "note": "Apple M6, 12 cores: 2 super + 4 performance + 6 efficiency, 32 GB. Same rule as the M1 Max (prefill on every big core, decode leaves one to the OS); a first setting, not tuned by a thread sweep.", "prefill_threads": 6}, "pi5": {"decode_threads": 3, "expect_backend": "cpu_neon", "note": "4x Cortex-A76, 4 GB reference board; decode leaves one core to the OS (same rule as apple_m1max). Thermals: active-cooling assumption; runner host gate handles load/settle.", "prefill_threads": 4}}, "models": {"bitnet-large-tq2": {"file": "bitnet_b1_58-large-TQ2_0.gguf", "sha256": "281aafb18a9f4a3124c10a1d8683e2296f0cfe8a2944da0a5667d17488a951bb"}, "bonsai2-27b-pq2": {"file": "Ternary-Bonsai-2-27B-PQ2_0.gguf", "sha256": "3907dc1658db1f78a9826bf8d5bcb8dc65db0d466388937af57f2294fae62ec1"}, "gemma4-e2b-q4km": {"file": "gemma4-e2b-Q4_K_M.gguf", "sha256": "740185b21d22ceb83a11c3aa62ad5842ef32c70f6096d756bbee85a1e4ec34b8"}, "gemma4-e4b-q4km": {"file": "gemma4-e4b-Q4_K_M.gguf", "sha256": "85a896a047553e842f25297ee5b031d64ff30147d9c4af17b1e4b394cd1fab87"}, "llama32-3b-q4km": {"file": "llama-3.2-3b-Q4_K_M.gguf", "sha256": "6c1a2b41161032677be168d354123594c0e6e67d2b9227c84f296ad037c728ff"}, "qwen3-0.6b-q8": {"file": "qwen3-0.6b-q8_0.gguf", "sha256": "9465e63a22add5354d9bb4b99e90117043c7124007664907259bd16d043bb031"}, "qwen35-0.8b-q8": {"file": "qwen3.5-0.8b-q8_0.gguf", "sha256": "0ad885ffd4bb022fc4f0d33a3308fa108ef8613159d3b3a67e23abca056b7a6c"}, "qwen35-4b-q4": {"file": "qwen3.5-4b-q4_0.gguf", "sha256": "298fcb5fe7a77ccc79745ae24751560c5ac56874caff4bb39b1f2055bd72b8bb"}, "qwen38-27b-q4": {"file": "qwen3.8-27b-q4_0.gguf", "sha256": "ede16c7b36e578ca87a8c70e011e4b4633a32c831c0ce76d0f474582384e671d"}}, "schema": "geist.benchmark.cross-engine-cpu.v2", "workload": {"affinity": "thread-count-only; operating-system scheduled for both engines", "aggregation": "median", "backend": "cpu-only", "cycles": 4, "decode_n": 64, "dispersion": "median_absolute_deviation", "kv_cache": "f16", "model_load_included": false, "repeats": 3, "seq_lens": [128, 256, 512, 1024], "thread_policy": "per host_profile; identical for both engines within a run", "thread_polling": "active", "warmup": "one discarded engine-native warmup before each measured test"}}, "protocol_sha256": "f6a4326927a2f4bac2c16828faa9b6df7356bdcc9720ec7836ec44effffeb36a", "runner": {"commit": "6642260d55a1d5ee71c85548b55ae277e6146228", "path": "tools/bench_cross_engine.py", "sha256": "a43598bcf9717cbb106062299a337535cd5bb384634758e410a96a57a872dfb6"}, "schema": "geist.benchmark.cross-engine-run.v1", "system": {"compiler": "Apple clang version 21.0.0 (clang-2100.4.1.1)", "cpu": "Apple M1 Max", "logical_cores": 10, "memory_bytes": "68719476736", "os": "Darwin 27.0.0", "performance_cores": "8", "product": "ProductName:\t\tmacOS\nProductVersion:\t\t27.0.1\nBuildVersion:\t\t26A434"}}
