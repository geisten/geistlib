#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer X {
    float x[];
};

layout(set = 0, binding = 1) writeonly buffer Y {
    float y[];
};

layout(push_constant) uniform Push {
    uint n;
    uint x_offset;
    uint y_offset;
    float scale;
    uint cols;     /* n = rows * cols; contiguous: cols = n */
    uint x_stride; /* row strides in floats (#504: row views of a wider */
    uint y_stride; /* tensor, deepseek2's strided copies) */
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) {
        return;
    }
    uint r = i / pc.cols;
    uint c = i - r * pc.cols;
    y[pc.y_offset + r * pc.y_stride + c] = x[pc.x_offset + r * pc.x_stride + c] * pc.scale;
}
