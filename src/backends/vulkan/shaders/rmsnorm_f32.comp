#version 450
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_basic : enable

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer X {
    float x[];
};

layout(set = 0, binding = 1) readonly buffer W {
    float w[];
};

layout(set = 0, binding = 2) writeonly buffer Y {
    float y[];
};

layout(push_constant) uniform Push {
    uint rows;
    uint feat;
    uint x_offset;
    uint w_offset;
    uint y_offset;
    float eps;
    uint x_stride; /* row strides in floats: feat for contiguous rows, more */
    uint y_stride; /* for row views of a wider tensor (#504) */
} pc;

/* Two-level reduce: subgroupAdd per subgroup + one tiny shared pass (a
 * shared-memory tree costs 14 barriers on the decode critical path).
 * One slot per subgroup, sized for any subgroup size: llvmpipe runs 8
 * lanes, Intel 8 or 16. */
shared float partial[256];

void main() {
    uint row = gl_WorkGroupID.x;
    uint lid = gl_LocalInvocationID.x;
    float sum = 0.0;
    for (uint j = lid; j < pc.feat; j += 256) {
        float v = x[pc.x_offset + row * pc.x_stride + j];
        sum = fma(v, v, sum);
    }
    sum = subgroupAdd(sum);
    if (subgroupElect()) {
        partial[gl_SubgroupID] = sum;
    }
    barrier();
    float total = 0.0;
    for (uint i = 0; i < gl_NumSubgroups; i++) {
        total += partial[i];
    }

    float inv = inversesqrt(total / float(pc.feat) + pc.eps);
    for (uint j = lid; j < pc.feat; j += 256) {
        y[pc.y_offset + row * pc.y_stride + j] =
                x[pc.x_offset + row * pc.x_stride + j] * inv * w[pc.w_offset + j];
    }
}
