#version 450
#include "vk_limits.h"

/* Mixture-of-experts routing on the device (#162): workgroup t takes row t
 * of logits and writes the k largest of its first n -- ranked by (logit
 * descending, id ascending), as the host's moe_route_topk -- into
 * ids[io + t * k + j], their softmax probabilities over all n into
 * w[wo + t * k + j], renormalised over the k when norm. A non-finite logit
 * sets ids[flag] to 1 (it ranks as -inf) and still writes k ids < n.
 *
 * Each logit's rank is the count of logits ahead of it in that order, so
 * the k picks need one pass over the row in shared memory, not k
 * reductions. n <= VK_MOE_TOPK_MAX_N. Dispatch: gx = rows. */

layout(local_size_x = 128) in;

layout(set = 0, binding = 0) readonly buffer L { float lg[]; };
layout(set = 0, binding = 1) buffer I { uint ids[]; };
layout(set = 0, binding = 2) buffer W { float w[]; };

layout(push_constant) uniform Push {
    uint n;
    uint k;
    uint norm;
    uint flag; /* words into ids */
    uint ls;   /* row stride of logits, elements */
    uint lo;   /* elements into lg */
    uint io;   /* words into ids */
    uint wo;   /* elements into w */
} pc;

shared float sh[VK_MOE_TOPK_MAX_N];
shared float sel[VK_MOE_TOPK_MAX_N];
shared float red[128];
shared uint bad;

void main() {
    uint t = gl_WorkGroupID.x;
    uint ti = gl_LocalInvocationID.x;
    uint base = pc.lo + t * pc.ls;
    const float NEG = uintBitsToFloat(0xff800000u);
    if (ti == 0u) {
        bad = 0u;
    }
    barrier();
    for (uint i = ti; i < pc.n; i += 128u) {
        float v = lg[base + i];
        if ((floatBitsToUint(v) & 0x7f800000u) == 0x7f800000u) {
            atomicOr(bad, 1u);
            v = NEG;
        }
        sh[i] = v;
    }
    barrier();
    for (uint i = ti; i < pc.n; i += 128u) {
        float v = sh[i];
        uint r = 0u;
        for (uint j = 0u; j < pc.n; ++j) {
            float u = sh[j];
            r += (u > v || (u == v && j < i)) ? 1u : 0u;
        }
        if (r < pc.k) {
            ids[pc.io + t * pc.k + r] = i;
            sel[r] = v;
        }
    }
    barrier();
    float mx = bad != 0u ? 0.0 : sel[0];
    float z = 0.0;
    for (uint i = ti; i < pc.n; i += 128u) {
        float v = sh[i];
        z += v == NEG ? 0.0 : exp(v - mx);
    }
    red[ti] = z;
    barrier();
    for (uint s = 64u; s > 0u; s >>= 1u) {
        if (ti < s) {
            red[ti] += red[ti + s];
        }
        barrier();
    }
    if (ti == 0u) {
        z = red[0];
        if (bad != 0u) {
            ids[pc.flag] = 1u;
        }
        float tot = 0.0;
        for (uint j = 0u; j < pc.k; ++j) {
            float p = z > 0.0 ? exp(sel[j] - mx) / z : 0.0;
            w[pc.wo + t * pc.k + j] = p;
            tot += p;
        }
        if (pc.norm != 0u && tot > 0.0) {
            for (uint j = 0u; j < pc.k; ++j) {
                w[pc.wo + t * pc.k + j] /= tot;
            }
        }
    }
}
