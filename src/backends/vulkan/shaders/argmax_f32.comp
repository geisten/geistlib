#version 450
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_EXT_control_flow_attributes : enable

/* Index of the largest x (ties: the lowest index; NaN never wins, all-NaN
 * gives 0xffffffff), one workgroup. A lane reads ARGMAX_UNROLL elements per
 * step, 256 apart, as independent loads: one strided load per step left a
 * vocabulary of 50k at ~200 dependent load latencies per lane, 20 us per
 * token on the RTX 2080 Ti (#514). The lanes reduce within their subgroup
 * (the maximum, then the lowest index holding it) and the subgroups' bests
 * in shared memory. */

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer X { float x[]; };
layout(set = 0, binding = 1) writeonly buffer Out { uint token_id[]; };

layout(push_constant) uniform Push {
    uint n;
    uint x_offset;
    uint out_offset;
} pc;

const uint ARGMAX_UNROLL = 8u;

shared float best_val[256]; /* one slot per subgroup (any subgroup size) */
shared uint best_idx[256];

void main() {
    uint lid = gl_LocalInvocationID.x;

    float local_val = uintBitsToFloat(0xff800000u);
    uint local_idx = 0xffffffffu;
    for (uint i0 = lid; i0 < pc.n; i0 += 256u * ARGMAX_UNROLL) {
        float v[ARGMAX_UNROLL];
        [[unroll]] for (uint u = 0u; u < ARGMAX_UNROLL; ++u) {
            uint i = i0 + u * 256u;
            v[u] = i < pc.n ? x[pc.x_offset + i] : uintBitsToFloat(0x7fc00000u);
        }
        [[unroll]] for (uint u = 0u; u < ARGMAX_UNROLL; ++u) {
            uint i = i0 + u * 256u;
            if (v[u] > local_val || (v[u] == local_val && i < local_idx)) {
                local_val = v[u];
                local_idx = i;
            }
        }
    }
    /* local_val is never NaN: a NaN fails both comparisons */
    float m = subgroupMax(local_val);
    uint mi = subgroupMin(local_val == m ? local_idx : 0xffffffffu);
    if (subgroupElect()) {
        best_val[gl_SubgroupID] = m;
        best_idx[gl_SubgroupID] = mi;
    }
    barrier();
    if (lid == 0u) {
        float bv = best_val[0];
        uint bi = best_idx[0];
        for (uint s = 1u; s < gl_NumSubgroups; ++s) {
            float v = best_val[s];
            uint i = best_idx[s];
            if (v > bv || (v == bv && i < bi)) {
                bv = v;
                bi = i;
            }
        }
        token_id[pc.out_offset] = bi;
    }
}
