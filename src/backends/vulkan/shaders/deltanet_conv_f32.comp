#version 450
#extension GL_GOOGLE_include_directive : enable
#include "vk_limits.h"

/* Gated-DeltaNet causal depthwise conv + SiLU (fused->deltanet_mix, stage 1).
 *
 *   y[t,c] = silu( sum_{j<K} w[c,j] * hist_j[c] )
 *
 * hist_j for j < K-1 is the persistent conv state (oldest first), hist_{K-1}
 * is the current token's pre-conv value. After the last token the state holds
 * the K-1 most recent PRE-conv vectors, exactly as the host oracle rolls it
 * (layer_deltanet.c). One thread owns one channel and walks the tokens in
 * order with its window in registers, so the in-place overwrite of qkv is
 * safe: x[t,c] is read into the window before y[t,c] replaces it. The taps
 * past K are zero weights, so the window loop has constant bounds (#467).
 *
 * Bindings: 0 qkv [seq, convd] in/out, 1 conv_w [convd, K], 2 conv_state
 * [(K-1), convd] in/out. Dispatch: gx = ceil(convd / 128). Size-agnostic
 * (no subgroup ops). */

layout(local_size_x = VK_DN_CONV_WG) in;

layout(set = 0, binding = 0) buffer QKV { float qkv[]; };
layout(set = 0, binding = 1) readonly buffer W { float cw[]; };
layout(set = 0, binding = 2) buffer ST { float cst[]; };

layout(push_constant) uniform Push {
    uint seq;
    uint convd;
    uint K;
    uint qkv_off;
    uint w_off;
    uint st_off;
} pc;

#include "silu.glsl"

/* Tokens per load batch: the batch's loads go out together, ahead of its
 * in-place stores (which the compiler will not move loads across). */
const uint BATCH = 8u;

void main() {
    uint c = gl_GlobalInvocationID.x;
    if (c >= pc.convd) {
        return;
    }
    const uint KMAX = VK_DN_MAX_CONV_K;
    uint hist = pc.K - 1u;
    /* window and taps in registers: constant indices, guarded by hist */
    float win[KMAX - 1u];
    float w[KMAX - 1u];
    for (uint j = 0u; j < KMAX - 1u; ++j) {
        win[j] = j < hist ? cst[pc.st_off + j * pc.convd + c] : 0.0;
        w[j] = j < hist ? cw[pc.w_off + c * pc.K + j] : 0.0;
    }
    float wx = cw[pc.w_off + c * pc.K + hist];
    for (uint t0 = 0u; t0 < pc.seq; t0 += BATCH) {
        float xb[BATCH];
        for (uint b = 0u; b < BATCH; ++b) {
            xb[b] = t0 + b < pc.seq ? qkv[pc.qkv_off + (t0 + b) * pc.convd + c] : 0.0;
        }
        for (uint b = 0u; b < BATCH; ++b) {
            if (t0 + b >= pc.seq) {
                break;
            }
            float xt = xb[b];
            float acc = 0.0;
            for (uint j = 0u; j < KMAX - 1u; ++j) {
                acc = fma(w[j], win[j], acc); /* w[j] = 0 past hist */
            }
            acc = fma(wx, xt, acc);
            qkv[pc.qkv_off + (t0 + b) * pc.convd + c] = silu(acc);
            /* roll: win[0..hist-2] <- win[1..hist-1], win[hist-1] <- xt */
            for (uint j = 0u; j < KMAX - 1u; ++j) {
                if (j + 1u < hist) {
                    win[j] = win[j + 1u];
                } else if (j + 1u == hist) {
                    win[j] = xt;
                }
            }
        }
    }
    for (uint j = 0u; j < KMAX - 1u; ++j) {
        if (j < hist) {
            cst[pc.st_off + j * pc.convd + c] = win[j];
        }
    }
}
