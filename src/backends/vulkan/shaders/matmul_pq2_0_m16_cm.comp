#version 450
#extension GL_KHR_cooperative_matrix : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable

/* PQ2_0 (Ternary-Bonsai) for 2..15 tokens on tensor cores (#105: the verify
 * pass of speculative decoding). The register-tiled matmul_pq2_0 pays its
 * dequantization per 32-token tile and the 128-row tensor-core tiles leave
 * most SMs idle at a handful of tokens; here a weight is decoded once and the
 * tokens ride the MMA's N = 16.
 *
 * A workgroup is 32 weight rows; its 8 subgroups are 8 k-slices (subgroup s
 * takes 128-element blocks s, s + 8, ...). Each subgroup owns both 16-row
 * tiles, so one token tile serves two weight tiles: the activations are the
 * traffic that grows with the token count (every workgroup reads them), the
 * weights are read once. A lane loads its two rows' whole blocks (16-byte
 * loads, the next block's in flight). Per 32-wide k-step a subgroup decodes
 * its two 16 x 32 weight tiles and loads its 16 x 32 token tile (tokens >=
 * rows are zero) into its own shared slots, then runs four 16 x 16 x 16
 * MMAs. The eight k-slices meet in shared memory at the end; only tokens <
 * rows are stored.
 *
 * GPU layout = struct-of-arrays (see matvec_pq2_0.comp). Requires a subgroup
 * size of 32, n_in % 128 == 0, x offset and stride % 4 == 0.
 * Dispatch: gx = ceil(n_out / 32), gy = 1. */

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer X { vec4 x4[]; };
layout(set = 0, binding = 1) readonly buffer W { uvec4 w4[]; };
layout(set = 0, binding = 2) writeonly buffer Y { float y[]; };

layout(push_constant) uniform Push {
    uint n_in;
    uint n_out;
    uint blocks_per_row;
    uint rows;
    uint x_offset;
    uint w_offset;
    uint y_offset;
    uint x_stride;
    uint y_stride;
} pc;

const uint BK = 32;
const uint STRIDE4 = BK / 8u + 1u; /* 4 uvec4 of data + 1 of padding per row */

shared uvec4 Ash[8][32 * STRIDE4];
shared uvec4 Bsh[8][16 * STRIDE4];
shared float red[8 * 512];

/* 8 ternary codes (16 bits) -> 8 packed f16 values (code - 1) * d without
 * an int -> float convert (quarter rate on Turing): code c goes into the f16
 * mantissa as 1 + c/4 (0x3C00 | c << 8); (1 + c/4 - 1.25) = (c - 1)/4 and its
 * product with 4d are exact in f16, so the values match the reference. */
uvec4 expand8(uint bits, f16vec2 d4) {
    uvec4 r;
    for (uint p = 0u; p < 4u; p++) {
        uint b = bits >> (4u * p);
        uint h = 0x3C003C00u | ((b & 3u) << 8u) | ((b & 12u) << 22u);
        r[p] = packFloat2x16((unpackFloat2x16(h) - f16vec2(1.25hf)) * d4);
    }
    return r;
}

/* a row's block: its 8 quant words and scale */
struct Blk {
    uvec4 a, b;
    float d;
};

Blk load_blk(uint row, uint ib, uint nb, uint sc0) {
    uint bi = row * nb + ib;
    uint sw = sc0 + (bi >> 1u);
    Blk k;
    k.a = w4[bi * 2u];
    k.b = w4[bi * 2u + 1u];
    k.d = unpackHalf2x16(w4[sw >> 2u][sw & 3u] >> ((bi & 1u) * 16u)).x;
    return k;
}

void main() {
    uint sg = gl_SubgroupID;
    uint lane = gl_SubgroupInvocationID;
    uint r0 = gl_WorkGroupID.x * 32u + (lane >> 1u);
    uint row0 = min(r0, pc.n_out - 1u), row1 = min(r0 + 16u, pc.n_out - 1u);
    uint hk = lane & 1u;
    uint t = lane >> 1u;
    bool tvalid = t < pc.rows;
    uint sc0 = pc.n_out * pc.blocks_per_row * 8u;
    uint base = (lane >> 1u) * STRIDE4 + hk * 2u;

    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc0 =
            coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc1 = acc0;

    uint nb = pc.blocks_per_row;
    uint ib = sg;
    Blk n0, n1;
    if (ib < nb) {
        n0 = load_blk(row0, ib, nb, sc0);
        n1 = load_blk(row1, ib, nb, sc0);
    }
    for (; ib < nb; ib += 8u) {
        Blk c0 = n0, c1 = n1;
        f16vec2 e0 = f16vec2(float16_t(4.0 * c0.d)), e1 = f16vec2(float16_t(4.0 * c1.d));
        if (ib + 8u < nb) { /* the next blocks' loads are in flight during this one */
            n0 = load_blk(row0, ib + 8u, nb, sc0);
            n1 = load_blk(row1, ib + 8u, nb, sc0);
        }
        for (uint j = 0u; j < 4u; j++) {
            uint k0 = ib * 128u + j * BK;
            /* word 2j + hk of the block's 8: k0 + 16hk .. + 15 */
            uvec4 h0 = j < 2u ? c0.a : c0.b, h1 = j < 2u ? c1.a : c1.b;
            uint q0 = hk == 0u ? h0[(2u * j) & 3u] : h0[(2u * j + 1u) & 3u];
            uint q1 = hk == 0u ? h1[(2u * j) & 3u] : h1[(2u * j + 1u) & 3u];
            Ash[sg][base] = expand8(q0 & 0xffffu, e0);
            Ash[sg][base + 1u] = expand8(q0 >> 16u, e0);
            Ash[sg][16u * STRIDE4 + base] = expand8(q1 & 0xffffu, e1);
            Ash[sg][16u * STRIDE4 + base + 1u] = expand8(q1 >> 16u, e1);
            uvec4 b0 = uvec4(0u), b1 = uvec4(0u);
            if (tvalid) {
                uint xv = (pc.x_offset + t * pc.x_stride + k0 + hk * 16u) >> 2u;
                vec4 x0 = x4[xv], x1 = x4[xv + 1u], x2 = x4[xv + 2u], x3 = x4[xv + 3u];
                b0 = uvec4(packHalf2x16(x0.xy), packHalf2x16(x0.zw), packHalf2x16(x1.xy),
                           packHalf2x16(x1.zw));
                b1 = uvec4(packHalf2x16(x2.xy), packHalf2x16(x2.zw), packHalf2x16(x3.xy),
                           packHalf2x16(x3.zw));
            }
            Bsh[sg][base] = b0;
            Bsh[sg][base + 1u] = b1;
            subgroupMemoryBarrierShared();
            subgroupBarrier();
            for (uint kk = 0u; kk < BK; kk += 16u) {
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> matB;
                coopMatLoad(matB, Bsh[sg], kk / 8u, STRIDE4, gl_CooperativeMatrixLayoutColumnMajor);
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> matA;
                coopMatLoad(matA, Ash[sg], kk / 8u, STRIDE4, gl_CooperativeMatrixLayoutRowMajor);
                acc0 = coopMatMulAdd(matA, matB, acc0);
                coopMatLoad(matA, Ash[sg], 16u * STRIDE4 + kk / 8u, STRIDE4,
                            gl_CooperativeMatrixLayoutRowMajor);
                acc1 = coopMatMulAdd(matA, matB, acc1);
            }
            subgroupBarrier(); /* the tiles are rewritten next step */
        }
    }

    coopMatStore(acc0, red, sg * 512u, 16u, gl_CooperativeMatrixLayoutRowMajor);
    coopMatStore(acc1, red, sg * 512u + 256u, 16u, gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    for (uint e = gl_LocalInvocationID.x; e < 512u; e += 256u) {
        uint r = e >> 4u; /* 0..31: tile e >> 8, row (e >> 4) & 15 */
        uint tt = e & 15u;
        uint o = gl_WorkGroupID.x * 32u + r;
        float sum = 0.0;
        for (uint k = 0u; k < 8u; k++) {
            sum += red[k * 512u + e];
        }
        if (tt < pc.rows && o < pc.n_out) {
            y[pc.y_offset + tt * pc.y_stride + o] = sum;
        }
    }
}
