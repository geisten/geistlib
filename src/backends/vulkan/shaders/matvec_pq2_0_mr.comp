#version 450
#include "vk_limits.h"

/* PQ2_0 (Ternary-Bonsai) for 2..8 activation rows (#192: speculative
 * verify). matvec_pq2_0 with every decoded weight reused for all rows: one
 * lane per output row walks its row block by block; the 1 + c/4 mantissa
 * trick decodes a code without an int -> float convert, and the rows'
 * multiply-adds follow on the FP pipe while the integer pipe decodes the
 * next codes. On the RTX 2080 Ti the single-row matvec is bound by the weight
 * stream, not by arithmetic, so extra rows cost FMAs, not bytes; the
 * tensor-core kernel (matmul_pq2_0_m16_cm) pays a shared-memory round trip
 * per weight instead.
 *
 * GPU layout (struct-of-arrays, see matvec_pq2_0.comp): 8 quant words per
 * 128-element block, all blocks first, then one f16 scale per block.
 *
 * A workgroup is 32 rows (lanes) x 8 k-slices (warps). The activations of
 * all rows are staged in shared memory 8 blocks (1024 elements) at a time,
 * with each block's sum, so warp w takes block w of the chunk. sum (c - 1) x
 * = 4 sum f x - 5 sum x as in matvec_pq2_0.
 *
 * Requires rows <= 8, n_in % 128 == 0, x offset and stride % 4 == 0.
 * Dispatch: gx = ceil(n_out / 32). */

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer X { vec4 x4[]; };
layout(set = 0, binding = 1) readonly buffer W { uvec4 w4[]; };
layout(set = 0, binding = 2) writeonly buffer Y { float y[]; };

layout(push_constant) uniform Push {
    uint n_in;
    uint n_out;
    uint blocks_per_row;
    uint rows;
    uint x_offset;
    uint w_offset;
    uint y_offset;
    uint x_stride;
    uint y_stride;
} pc;

const uint R = 8u;  /* most rows */
const uint CB = 8u; /* blocks per staged chunk = warps */

float mant(uint qw, uint k) {
    uint m = k <= 10u ? (qw << ((21u - 2u * k) & 31u)) : (qw >> ((2u * k - 21u) & 31u));
    return uintBitsToFloat(0x3F800000u | (m & 0x00600000u));
}

shared vec4 xsh[R][CB * 32u];
shared float xsum[R][CB];
shared float red[8][32][R];

void main() {
    uint lane = gl_LocalInvocationID.x & 31u;
    uint ks = gl_LocalInvocationID.x >> 5u;
    uint row = gl_WorkGroupID.x * VK_MV_PQ2_0_ROWS_PER_WG + lane;
    uint nb = pc.blocks_per_row;
    uint rrow = min(row, pc.n_out - 1u);
    uint sc0 = pc.n_out * nb * 8u;
    uint nr = min(pc.rows, R);

    float acc[R];
    for (uint r = 0u; r < R; r++) {
        acc[r] = 0.0;
    }
    for (uint c0 = 0u; c0 < nb; c0 += CB) {
        barrier(); /* the previous chunk is no longer read */
        for (uint i = gl_LocalInvocationID.x; i < R * CB * 32u; i += 256u) {
            uint r = i / (CB * 32u), v = i % (CB * 32u);
            uint b = c0 + v / 32u;
            xsh[r][v] = (r < nr && b < nb)
                    ? x4[((pc.x_offset + r * pc.x_stride) >> 2u) + c0 * 32u + v]
                    : vec4(0.0);
        }
        barrier();
        if (gl_LocalInvocationID.x < R * CB) { /* each block's sum, per row */
            uint r = gl_LocalInvocationID.x / CB, bl = gl_LocalInvocationID.x % CB;
            vec4 s = vec4(0.0);
            for (uint g = 0u; g < 32u; g++) {
                s += xsh[r][bl * 32u + g];
            }
            xsum[r][bl] = s.x + s.y + s.z + s.w;
        }
        barrier();
        uint b = c0 + ks;
        if (b < nb) {
            uint bi = rrow * nb + b;
            uvec4 qa = w4[bi * 2u];
            uvec4 qb = w4[bi * 2u + 1u];
            uint sw = sc0 + (bi >> 1u);
            float d = unpackHalf2x16(w4[sw >> 2u][sw & 3u] >> ((bi & 1u) * 16u)).x;
            vec4 sv[R];
            for (uint r = 0u; r < R; r++) {
                sv[r] = vec4(0.0);
            }
            for (uint g = 0u; g < 32u; ++g) {
                uint qw = g < 16u ? qa[g >> 2u] : qb[(g - 16u) >> 2u];
                uint k = (g & 3u) * 4u;
                vec4 f = vec4(mant(qw, k), mant(qw, k + 1u), mant(qw, k + 2u), mant(qw, k + 3u));
                for (uint r = 0u; r < R; r++) {
                    if (r < nr) {
                        sv[r] += f * xsh[r][ks * 32u + g];
                    }
                }
            }
            for (uint r = 0u; r < R; r++) {
                acc[r] += d * fma(4.0, sv[r].x + sv[r].y + sv[r].z + sv[r].w, -5.0 * xsum[r][ks]);
            }
        }
    }
    for (uint r = 0u; r < R; r++) {
        red[ks][lane][r] = acc[r];
    }
    barrier();
    if (ks == 0u && row < pc.n_out) {
        for (uint r = 0u; r < nr; r++) {
            float t = 0.0;
            for (uint i = 0u; i < 8u; ++i) {
                t += red[i][lane][r];
            }
            y[pc.y_offset + r * pc.y_stride + row] = t;
        }
    }
}
